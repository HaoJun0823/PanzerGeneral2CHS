###############################################################################
# PanzerGeneral2CHS — 换行符策略
###############################################################################
# 默认：源码 / 配置 / 文档按平台习惯规范化（text=auto）。
* text=auto

###############################################################################
# 游戏文本表 / 二进制资产：一律 -text（禁止任何换行符转换）
# ----------------------------------------------------------------------------
# 理由（与 ArmyMenCHS 同款坑）：
#   本仓库同时含两类文件：
#     1. 源码 / 配置 / 文档        —— 文本，按平台习惯处理；
#     2. 游戏文本表（Resources/**/*.txt）—— 游戏按「行 / 字节」解析，
#        CRLF↔LF 改写会破坏行解析或引入尾随 \r；
#     3. 二进制工具 / 字体 / 档案 —— 任何改写即损坏。
#   故第 2、3 类一律 -text。
###############################################################################
*.txt     -text
*.exe     -text
*.dll     -text
*.asi     -text
*.dat     -text
*.png     -text
*.bmp     -text
*.jpg     -text
*.ttf     -text
*.ttc     -text
*.otf     -text
*.idb     -text
*.i64     -text
*.pdb     -text

###############################################################################
# 解决方案 / 工程文件：按二进制合并（VS 里不插 diff 标记）
###############################################################################
*.sln       merge=binary
*.vcxproj   merge=binary
*.vcxproj.filters merge=binary
